<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GamePortals</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GamePortals.styles.css" asp-append-version="true" />

    <script>
        (function () {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3 py-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-uppercase" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="text-primary"><i class="bi bi-controller"></i> Game</span>Portals
                </a>

                <div class="d-flex align-items-center ms-auto me-2 order-sm-last">
                    <button class="btn btn-link nav-link shadow-none" id="darkModeToggle" type="button">
                        <i class="bi bi-moon-stars-fill fs-5" id="themeIcon"></i>
                    </button>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Начало
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Games" asp-action="Index">
                                <i class="bi bi-gamepad"></i> Игри
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Genres" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap-fill"></i> Категории
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-area="" asp-controller="Reviews" asp-action="Index">
                                    <i class="bi bi-person-badge"></i>
                                    @(User.IsInRole("Admin") ? "Админ Панел" : "Моите Ревюта")
                                </a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto py-3 shadow-sm">
        <div class="container">
            &copy; 2026 - <span class="fw-bold text-primary">GamePortals</span> -
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Политика за поверителност</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        const btn = document.getElementById('darkModeToggle');
        const icon = document.getElementById('themeIcon');
        const htmlElement = document.documentElement;

        function updateIcon(theme) {
            if (theme === 'dark') {
                icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
                icon.style.color = '#ffca28';
            } else {
                icon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
                icon.style.color = '#fff';
            }
        }

        updateIcon(htmlElement.getAttribute('data-bs-theme'));

        btn.addEventListener('click', () => {
            const currentTheme = htmlElement.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'light' ? 'dark' : 'light';

            htmlElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            updateIcon(newTheme);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>