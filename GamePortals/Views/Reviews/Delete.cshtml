@model GamePortals.Models.Review

@{
    ViewData["Title"] = "Изтриване на ревю";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h3 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Потвърждение за изтриване</h3>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="lead mb-4">Сигурни ли сте, че искате да премахнете това ревю за играта:</p>
                    <h4 class="text-primary mb-4">@Model.Game?.Title</h4>

                    <div class="bg-light rounded p-3 mb-4 border text-start">
                        <div class="mb-2">
                            <strong>Оценка:</strong>
                            <span class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= Model.Rating ? "-fill" : "")"></i>
                                }
                            </span>
                        </div>
                        <div>
                            <strong>Коментар:</strong>
                            <p class="text-muted mb-0 italic">"@Model.Content"</p>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <button type="submit" class="btn btn-danger btn-lg px-4 fw-bold">
                                <i class="bi bi-trash"></i> Да, изтрий го!
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                Отказ
                            </a>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-muted text-center small py-2">
                    Внимание: Това действие е необратимо.
                </div>
            </div>
        </div>
    </div>
</div>