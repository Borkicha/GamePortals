@model IEnumerable<GamePortals.Models.Review>

@{
    ViewData["Title"] = "Списък с ревюта";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary"><i class="bi bi-journal-text"></i> @ViewData["HeaderTitle"]</h1>

        <div class="btn-group shadow-sm">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Index" asp-route-sortOrder="game" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-sort-alpha-down"></i> Сортирай по Игра
                </a>
            }
            else
            {
                <a asp-action="Index" asp-route-sortOrder="rating" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-star-half"></i> Сортирай по Рейтинг
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Нулирай">
                <i class="bi bi-arrow-clockwise"></i>
            </a>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded border bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    @if (User.IsInRole("Admin"))
                    {
                        <th>Автор</th>
                    }
                    <th>Игра</th>
                    <th style="min-width: 120px;">Оценка</th>
                    <th>Коментар</th>
                    <th class="text-end pe-3">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @if (User.IsInRole("Admin"))
                        {
                            <td>
                                <span class="fw-bold text-dark">
                                    <i class="bi bi-person-circle text-primary"></i>
                                    @(item.User?.UserName?.Split('@')[0] ?? "Потребител")
                                </span>

                                @if (item.User?.Email == "Borkicha@admin.com")
                                {
                                    <span class="badge bg-danger ms-1 shadow-sm" style="font-size: 0.75rem; border: 1px solid #900;">
                                        <i class="bi bi-shield-fill-check"></i> ЕКИП
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark ms-1 shadow-sm" style="font-size: 0.75rem;">
                                        <i class="bi bi-person-fill"></i> ПОТРЕБИТЕЛ
                                    </span>
                                }
                            </td>
                        }
                        <td>
                            <a asp-controller="Games" asp-action="Details" asp-route-id="@item.GameId" class="text-decoration-none fw-bold text-dark">
                                @(item.Game?.Title ?? "Няма информация")
                            </a>
                        </td>
                        <td>
                            <span class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= item.Rating ? "-fill" : "")"></i>
                                }
                            </span>
                        </td>
                        <td class="text-muted small">@item.Content</td>
                        <td class="text-end pe-3">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Редактирай">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Изтрий">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>