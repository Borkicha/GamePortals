@model IEnumerable<GamePortals.Models.Review>

@{
    ViewData["Title"] = "Списък с ревюта";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary"><i class="bi bi-journal-text"></i> @ViewData["HeaderTitle"]</h1>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm" title="Нулирай">
            <i class="bi bi-arrow-clockwise"></i> Опресни
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded border bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    @if (User.IsInRole("Admin"))
                    {
                        <th style="cursor: pointer;" onclick="sortTable(0, this, 'text')">
                            Автор <i class="bi bi-arrow-down-up ms-1 small opacity-50"></i>
                        </th>
                    }
                    <th>Игра</th>
                    <th style="min-width: 150px; cursor: pointer;" onclick="sortTable(@(User.IsInRole("Admin") ? 2 : 1), this, 'number')">
                        Оценка <i class="bi bi-arrow-down-up ms-1 small opacity-50"></i>
                    </th>
                    <th>Коментар</th>
                    <th class="text-end pe-3">Действия</th>
                </tr>
            </thead>
            <tbody id="reviewsTable">
                @foreach (var item in Model)
                {
                    <tr>
                        @if (User.IsInRole("Admin"))
                        {
                            <td data-author="@(item.User?.UserName ?? "Потребител")">
                                <span class="fw-bold text-dark">
                                    <i class="bi bi-person-circle text-primary"></i>
                                    @(item.User?.UserName?.Split('@')[0] ?? "Потребител")
                                </span>

                                @if (item.User?.Email == "Borkicha@admin.com")
                                {
                                    <span class="badge bg-danger ms-1 shadow-sm" style="font-size: 0.75rem; border: 1px solid #900;">
                                        <i class="bi bi-shield-fill-check"></i> ЕКИП
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark ms-1 shadow-sm" style="font-size: 0.75rem;">
                                        <i class="bi bi-person-fill"></i> ПОТРЕБИТЕЛ
                                    </span>
                                }
                            </td>
                        }
                        <td>
                            <a asp-controller="Games" asp-action="Details" asp-route-id="@item.GameId" class="text-decoration-none fw-bold text-dark">
                                @(item.Game?.Title ?? "Няма информация")
                            </a>
                        </td>
                        <td data-rating="@item.Rating">
                            <span class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= item.Rating ? "-fill" : "")"></i>
                                }
                            </span>
                            <span class="ms-1 small text-muted">(@item.Rating)</span>
                        </td>
                        <td class="text-muted small">@item.Content</td>
                        <td class="text-end pe-3">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Редактирай">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Изтрий">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        let sortDirections = {};

        function sortTable(colIndex, headerElement, type) {
            const tableBody = document.getElementById("reviewsTable");
            const rows = Array.from(tableBody.querySelectorAll("tr"));

            sortDirections[colIndex] = !sortDirections[colIndex];
            const isAsc = sortDirections[colIndex];

            document.querySelectorAll('th i').forEach(i => i.className = 'bi bi-arrow-down-up ms-1 small opacity-50');
            const icon = headerElement.querySelector('i');
            icon.className = isAsc ?
                (type === 'number' ? 'bi bi-sort-numeric-down ms-1 text-primary' : 'bi bi-sort-alpha-down ms-1 text-primary') :
                (type === 'number' ? 'bi bi-sort-numeric-up-alt ms-1 text-primary' : 'bi bi-sort-alpha-up-alt ms-1 text-primary');
            icon.classList.remove('opacity-50');

            const sortedRows = rows.sort((a, b) => {
                let valA, valB;

                if (type === 'number') {
                    valA = parseFloat(a.cells[colIndex].getAttribute('data-rating'));
                    valB = parseFloat(b.cells[colIndex].getAttribute('data-rating'));
                    return isAsc ? valA - valB : valB - valA;
                } else {
                    valA = a.cells[colIndex].innerText.trim().toLowerCase();
                    valB = b.cells[colIndex].innerText.trim().toLowerCase();
                    return isAsc ? valA.localeCompare(valB, 'bg') : valB.localeCompare(valA, 'bg');
                }
            });

            sortedRows.forEach(row => tableBody.appendChild(row));
        }
    </script>
}