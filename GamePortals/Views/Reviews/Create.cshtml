@model GamePortals.Models.Review

@{
    ViewData["Title"] = "Напиши ревю";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 shadow-lg p-4 bg-white rounded border">
            <h2 class="mb-3 text-primary">
                <i class="bi bi-pencil-fill"></i> Напиши ревю
            </h2>

            <div class="alert alert-info border-0 shadow-sm">
                <strong>Игра:</strong> @ViewBag.GameTitle
            </div>
            <hr />

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" name="GameId" value="@ViewBag.GameId" />

                <div class="form-group mb-4 text-center">
                    <label class="control-label fw-bold d-block mb-2">Твоята оценка</label>

                    <input type="hidden" asp-for="Rating" id="ratingValue" value="0" />

                    <div class="star-rating display-5">
                        <i class="bi bi-star star-icon text-muted" data-value="1" style="cursor: pointer;"></i>
                        <i class="bi bi-star star-icon text-muted" data-value="2" style="cursor: pointer;"></i>
                        <i class="bi bi-star star-icon text-muted" data-value="3" style="cursor: pointer;"></i>
                        <i class="bi bi-star star-icon text-muted" data-value="4" style="cursor: pointer;"></i>
                        <i class="bi bi-star star-icon text-muted" data-value="5" style="cursor: pointer;"></i>
                    </div>
                    <span asp-validation-for="Rating" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Content" class="control-label fw-bold">Твоят коментар</label>
                    <textarea asp-for="Content" class="form-control" rows="5" placeholder="Сподели мнението си за играта..." required></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end border-top pt-3">
                    <a asp-controller="Games" asp-action="Details" asp-route-id="@ViewBag.GameId" class="btn btn-outline-secondary px-4">Отказ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                        <i class="bi bi-send-fill"></i> Публикувай ревюто
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .star-icon.active {
        color: #ffc107 !important;
    }

    .star-icon {
        transition: transform 0.1s ease;
    }

        .star-icon:hover {
            transform: scale(1.2);
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const stars = document.querySelectorAll('.star-icon');
            const ratingInput = document.getElementById('ratingValue');

            stars.forEach(star => {
                star.addEventListener('click', function () {
                    const val = this.getAttribute('data-value');
                    ratingInput.value = val;
                    updateStars(val);
                });

                star.addEventListener('mouseover', function () {
                    const val = this.getAttribute('data-value');
                    updateStars(val);
                });

                star.addEventListener('mouseout', function () {
                    updateStars(ratingInput.value);
                });
            });

            function updateStars(value) {
                stars.forEach(star => {
                    const starValue = star.getAttribute('data-value');
                    if (starValue <= value) {
                        star.classList.remove('bi-star', 'text-muted');
                        star.classList.add('bi-star-fill', 'active');
                    } else {
                        star.classList.remove('bi-star-fill', 'active');
                        star.classList.add('bi-star', 'text-muted');
                    }
                });
            }
        });
    </script>
}