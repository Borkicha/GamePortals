@model GamePortals.Models.Game

@{
    ViewData["Title"] = Model.Title;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<h1 class="mb-4 text-uppercase fw-bold"><i class="bi bi-controller text-primary"></i> @Model.Title</h1>

<div class="row shadow-lg p-4 bg-white rounded border mx-0">
    <div class="col-md-4 text-center">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded shadow-lg border" style="max-height: 450px; object-fit: cover;" />
        }
        else
        {
            <div class="bg-dark text-white text-center border rounded d-flex align-items-center justify-content-center shadow-sm" style="height: 350px;">
                <div class="p-3">
                    <i class="bi bi-image-fill fs-1 d-block mb-2"></i>
                    <span class="text-uppercase small fw-bold">Липсва обложка</span>
                </div>
            </div>
        }
    </div>

    <div class="col-md-8">
        <h4 class="text-primary text-uppercase fw-bold"><i class="bi bi-info-square-fill"></i> Инфо за играта</h4>
        <hr />

        <div class="game-stats fs-5">
            <div class="row mb-3">
                <div class="col-sm-4 fw-bold text-secondary text-uppercase" style="font-size: 0.9rem;">Игра:</div>
                <div class="col-sm-8 fw-bold">@Model.Title</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 fw-bold text-secondary text-uppercase" style="font-size: 0.9rem;">Описание:</div>
                <div class="col-sm-8 text-dark" style="line-height: 1.6;">@Model.Description</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 fw-bold text-secondary text-uppercase" style="font-size: 0.9rem;">Категория:</div>
                <div class="col-sm-8">
                    <span class="badge bg-primary px-3 py-2">@(Model.Genre?.Name ?? "General")</span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 fw-bold text-secondary text-uppercase" style="font-size: 0.9rem;">Цена:</div>
                <div class="col-sm-8 fw-bold text-success font-monospace">@Model.Price €</div>
            </div>

            <div class="row mb-3 align-items-center">
                <div class="col-sm-4 fw-bold text-secondary text-uppercase" style="font-size: 0.9rem;">Рейтинг на играчите:</div>
                <div class="col-sm-8">
                    @if (ViewBag.AverageRating != "Няма оценки")
                    {
                        <div class="d-flex align-items-center">
                            <span class="text-warning fw-bold fs-4 me-2">
                                <i class="bi bi-star-fill"></i> @ViewBag.AverageRating
                            </span>
                            <span class="text-muted small">/ 5.0 (@(Model.Reviews?.Count() ?? 0) гласа)</span>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Все още никой не е дал оценка</span>
                    }
                </div>
            </div>
        </div>

        <div class="mt-5 pt-3 border-top d-flex flex-wrap gap-2">
            <a asp-controller="Reviews" asp-action="Create" asp-route-id="@Model.Id" class="btn btn-success btn-lg px-4 shadow-sm">
                <i class="bi bi-pencil-square"></i> Напиши ревю
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning btn-lg px-4 shadow-sm">
                    <i class="bi bi-gear-fill"></i> Редактирай
                </a>
            }

            <a asp-action="Index" class="btn btn-outline-dark btn-lg px-4 shadow-sm">
                <i class="bi bi-list-ul"></i> Към каталога
            </a>
        </div>
    </div>
</div>

<hr class="my-5" />

<div class="reviews-section pb-5">
    <div class="d-flex align-items-center mb-4">
        <h3 class="text-uppercase fw-bold mb-0 me-3"><i class="bi bi-chat-left-dots-fill text-primary"></i> Мнения на играчите</h3>
        <span class="badge bg-secondary">@(Model.Reviews?.Count() ?? 0)</span>
    </div>

    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        @foreach (var review in Model.Reviews)
        {
            <div class="card mb-4 shadow-sm border-0 bg-light overflow-hidden">
                <div class="card-body p-0">
                    <div class="d-flex flex-column flex-md-row">
                        <div class="p-3 bg-dark text-white text-center d-flex flex-column justify-content-center align-items-center" style="min-width: 150px;">
                            <i class="bi bi-person-circle fs-2"></i>
                            <span class="fw-bold mt-1">@(review.User?.UserName?.Split('@')[0] ?? "Gamer")</span>

                            @if (review.User?.Email == "Borkicha@admin.com")
                            {
                                <span class="badge bg-danger mt-2 text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">
                                    <i class="bi bi-shield-fill"></i> Екип
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary mt-2 text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">
                                    <i class="bi bi-controller"></i> Играч
                                </span>
                            }
                        </div>

                        <div class="p-4 bg-white w-100 border-start">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="text-warning fs-5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi bi-star@(i <= review.Rating ? "-fill" : "")"></i>
                                    }
                                </div>
                            </div>
                            <p class="card-text text-dark fst-italic" style="font-size: 1.1rem; line-height: 1.6;">
                                "@review.Content"
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-secondary border-0 shadow-sm text-center py-5">
            <i class="bi bi-chat-dots fs-1 d-block mb-3 opacity-50"></i>
            <p class="mb-0 fs-5">Все още няма коментари за тази игра.</p>
            <p class="text-muted">Бъди първият, който ще сподели мнение!</p>
        </div>
    }
</div>