@model GamePortals.Models.Game

@{
    ViewData["Title"] = "Премахване на игра";
}

<div class="container mt-4">
    @* Заглавие с икона за внимание *@
    <h1 class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Изтриване на запис</h1>

    @* Предупредително съобщение *@
    <div class="alert alert-warning border-danger shadow-sm py-3">
        <h4 class="alert-heading fw-bold"><i class="bi bi-shield-exclamation"></i> Внимание!</h4>
        <p class="mb-0 fs-5">Сигурни ли сте, че искате да изтриете <strong>@Model.Title</strong>? Това действие е необратимо.</p>
    </div>

    <div class="row shadow-sm p-4 bg-white rounded border mx-0 mt-4 align-items-center">
        @* СЕКЦИЯ СНИМКА (Обложка) *@
        <div class="col-md-4 text-center border-end">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded shadow border" style="max-height: 250px; object-fit: cover;" />
            }
            else
            {
                <div class="bg-light border rounded d-flex flex-column align-items-center justify-content-center" style="height: 200px;">
                    <i class="bi bi-image text-muted fs-1"></i>
                    <span class="text-muted">Няма обложка</span>
                </div>
            }
        </div>

        @* СЕКЦИЯ ДАННИ *@
        <div class="col-md-8 ps-md-5">
            <h4 class="text-secondary text-uppercase small fw-bold mb-3">Детайли за потвърждение</h4>

            <div class="mb-2">
                <span class="text-muted">Игра:</span>
                <div class="fs-4 fw-bold text-dark">@Model.Title</div>
            </div>

            <div class="mb-2">
                <span class="text-muted">Категория:</span>
                <div>
                    @* ТУК ВЕЧЕ ПОКАЗВАМЕ ИМЕТО, А НЕ ID *@
                    <span class="badge bg-primary fs-6">@(Model.Genre?.Name ?? "Няма категория")</span>
                </div>
            </div>

            <div class="mb-3">
                <span class="text-muted">Описание:</span>
                <p class="text-secondary small italic">@Model.Description</p>
            </div>

            <div class="mt-4 pt-3 border-top">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn btn-danger btn-lg px-4 shadow-sm me-2 fw-bold">
                        <i class="bi bi-trash-fill"></i> Изтрий завинаги
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 text-uppercase small fw-bold">
                        Отказ
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>