@model Game

@{
    ViewData["Title"] = "Редактиране на игра";
}

<h1 class="text-primary"><i class="bi bi-pencil-square"></i> Редактиране на игра</h1>

<h4 class="text-secondary">@Model.Title</h4>
<hr />
<div class="row">
    <div class="col-md-6 col-lg-4">
        <form asp-action="Edit" class="shadow-sm p-4 bg-white rounded border">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label fw-bold">Заглавие на играта</label>
                <input asp-for="Title" class="form-control" placeholder="Въведи име на играта..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label fw-bold">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Кратко инфо за сюжета..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="GenreId" class="control-label fw-bold">Категория</label>
                <select asp-for="GenreId" class="form-select" asp-items="ViewBag.GenreId">
                    <option value="">-- Избери категория --</option>
                </select>
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label fw-bold">Цена (в EUR)</label>
                <div class="input-group">
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    <span class="input-group-text">€</span>
                </div>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImageUrl" class="control-label fw-bold">URL на обложката</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success w-100 fw-bold">
                    <i class="bi bi-check-circle"></i> Запази промените
                </button>
            </div>
        </form>
    </div>

    <div class="col-md-4 text-center d-none d-md-block">
        <p class="text-muted small text-uppercase fw-bold">Текуща обложка</p>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-thumbnail shadow" style="max-height: 300px;" />
        }
        else
        {
            <div class="bg-light border rounded p-5 text-muted">Няма зададена картинка</div>
        }
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Назад към каталога
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}