@model Genre

@{
    ViewData["Title"] = "Нова категория";
}

<div class="container mt-4">
    <h1 class="text-primary fw-bold"><i class="bi bi-plus-square-fill"></i> Добави нова категория</h1>
    <p class="text-muted">Създай нов жанр, за да организираш гейминг каталога си.</p>
    <hr />

    <div class="row">
        <div class="col-md-6 col-lg-5">
            <form asp-action="Create" method="post" class="shadow p-4 bg-white rounded border border-primary-subtle">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-4">
                    <label asp-for="Name" class="control-label fw-bold mb-2">Име на категорията</label>
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white"><i class="bi bi-tag-fill"></i></span>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="Напр. Шуутър, Стратегия..." />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm fw-bold">
                        <i class="bi bi-cloud-arrow-up-fill"></i> Създай категорията
                    </button>
                </div>
            </form>
        </div>

        <div class="col-md-4 ms-lg-5 d-none d-md-flex align-items-center justify-content-center">
            <div class="text-center opacity-25">
                <i class="bi bi-grid-3x3-gap" style="font-size: 8rem;"></i>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Назад към списъка
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}