@model IEnumerable<GamePortals.Models.Genre>

@{
    ViewData["Title"] = "Категории";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">
            <i class="bi bi-tags-fill"></i> Списък с Категории
        </h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-circle"></i> Добави Нова Категория
            </a>
        }
    </div>

    <div class="row mb-4">
        <div class="col-md-6 col-lg-5">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-primary"></i>
                </span>
                <input type="text" id="genreSearch" class="form-control border-start-0 ps-0"
                       placeholder="Търси категория..." autocomplete="off" />
            </div>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded border bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4 text-uppercase small" style="letter-spacing: 1px;">Име на категорията</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th class="text-end pe-4 text-uppercase small" style="letter-spacing: 1px;">Действия</th>
                    }
                </tr>
            </thead>
            <tbody id="genresTable">
                @foreach (var item in Model)
                {
                    <tr class="position-relative clickable-row">
                        <td class="ps-4 fw-bold fs-5 genre-name">
                            <a asp-controller="Games"
                               asp-action="Index"
                               asp-route-categoryId="@item.Id"
                               class="text-decoration-none text-dark stretched-link">
                                <i class="bi bi-hash text-primary me-1"></i>
                                @item.Name
                            </a>
                        </td>

                        @if (User.IsInRole("Admin"))
                        {
                            <td class="text-end pe-4">
                                <div class="btn-group position-relative" style="z-index: 5;">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Редактирай">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Изтрий">
                                        <i class="bi bi-trash3-fill"></i>
                                    </a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="noGenres" class="alert alert-light border text-center shadow-sm mt-4" style="display: none;">
        <i class="bi bi-info-circle me-2"></i>
        <span>Няма намерени категории за това търсене.</span>
    </div>

    @if (User.IsInRole("Admin") && !Model.Any())
    {
        <div class="alert alert-light border mt-3 text-center shadow-sm">
            <i class="bi bi-info-circle"></i> Все още няма създадени категории.
        </div>
    }
</div>

<style>
    .clickable-row {
        transition: background-color 0.2s;
        cursor: pointer;
    }

        .clickable-row:hover {
            background-color: rgba(13, 110, 253, 0.05) !important;
        }

            .clickable-row:hover .text-dark {
                color: #0d6efd !important;
            }
</style>

@section Scripts {
    <script>
        document.getElementById('genreSearch').addEventListener('input', function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#genresTable tr');
            let hasVisibleRows = false;

            rows.forEach(row => {
                let name = row.querySelector('.genre-name').innerText.toLowerCase();

                if (name.includes(filter)) {
                    row.style.display = "";
                    hasVisibleRows = true;
                } else {
                    row.style.display = "none";
                }
            });

            document.getElementById('noGenres').style.display = hasVisibleRows ? "none" : "block";
        });
    </script>
}