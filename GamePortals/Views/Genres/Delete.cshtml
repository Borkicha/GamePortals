@model Genre

@{
    ViewData["Title"] = "Изтриване на категория";
}

<div class="container mt-4">
    <h1 class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Изтриване на категория</h1>

    <div class="alert alert-warning border-danger shadow-sm py-3">
        <h4 class="alert-heading fw-bold"><i class="bi bi-shield-exclamation"></i> Внимание!</h4>
        <p class="mb-0 fs-5">Сигурни ли сте, че искате да изтриете категория <strong>@Model.Name</strong>? Това може да повлияе на игрите, които са свързани с нея.</p>
    </div>

    <div class="row shadow-sm p-4 bg-white rounded border mx-0 mt-4 align-items-center">
        <div class="col-md-2 text-center border-end d-none d-md-block">
            <i class="bi bi-tags-fill text-danger" style="font-size: 4rem;"></i>
        </div>

        <div class="col-md-10 ps-md-4">
            <h4 class="text-secondary text-uppercase small fw-bold mb-3">Данни за потвърждение</h4>

            <div class="mb-4">
                <span class="text-muted">Име на категорията:</span>
                <div class="fs-3 fw-bold text-dark">@Model.Name</div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn btn-danger btn-lg px-4 shadow-sm me-2 fw-bold">
                        <i class="bi bi-trash-fill"></i> Потвърждавам изтриването
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 text-uppercase small fw-bold">
                        Отказ
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>